NODE_ENV=production
HOST=127.0.0.1
PORT=
DATABASE_URL=postgres://catering_app:change-me@127.0.0.1:5432/catering_service
DATABASE_SSL=require
OIDC_ISSUER=https://identity.example.org/
OIDC_AUDIENCE=catering-commerce
OIDC_LOGIN_URL=https://identity.example.org/authorize
AUTH_PUBLIC_KEY_BASE64=base64-encoded-RS256-public-key
WEBHOOK_SIGNING_SECRET=replace-with-at-least-32-random-characters
TAX_BASE_URL=https://tax.example.org
TAX_BEARER_TOKEN=replace-me
PAYMENT_BASE_URL=https://payments.example.org
PAYMENT_BEARER_TOKEN=replace-me
DELIVERY_BASE_URL=https://delivery.example.org
DELIVERY_BEARER_TOKEN=replace-me
ALLOW_SCHEMA_MIGRATION=0
ALLOW_LOCAL_PASSWORD_LOGIN=false
ADMIN_EMAIL=
ADMIN_PASSWORD=
