{
  "name": "catering-service-commerce-api",
  "version": "2.0.0",
  "private": true,
  "description": "Governed catering reservation, payment, fulfillment, refund, delivery, and reconciliation API",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "build": "node --check src/index.js && node --check src/commerce/app.js",
    "check": "node src/commerce/cli.js check",
    "migrate:deploy": "node src/commerce/cli.js migrate",
    "create-admin": "node scripts/create-admin.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3"
  },
  "engines": { "node": ">=18" }
}
